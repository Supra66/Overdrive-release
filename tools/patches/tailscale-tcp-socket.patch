@@ -797,9 +797,60 @@ func acmeClient(cs certStore) (*acme.Client, error) {
 		Key:          key,
 		UserAgent:    "tailscaled/" + version.Long(),
 		DirectoryURL: envknob.String("TS_DEBUG_ACME_DIRECTORY_URL"),
+		HTTPClient:   acmeHTTPClient(),
 	}, nil
 }
 
+// acmeFallbackResolvers are queried only when the platform exposes no resolver
+// configuration at all. Overridable with TS_ACME_DNS (comma-separated host:port).
+var acmeFallbackResolvers = []string{"1.1.1.1:53", "8.8.8.8:53"}
+
+// acmeHTTPClient returns the HTTP client for ACME, or nil to use the default.
+//
+// Android has no /etc/resolv.conf. A cgo-free build therefore has nothing to
+// configure Go's pure resolver from, and it falls back to 127.0.0.1:53 where
+// nothing is listening — every lookup fails with "connection refused". Reaching
+// the control plane still works, because that path has bootstrap DNS with
+// hardcoded addresses; an arbitrary host like the ACME directory does not. The
+// visible result is a cert fetch that fails at DNS, so `serve --https` publishes
+// a URL whose TLS handshake dies with an internal error.
+//
+// Only take over when there is genuinely no resolver config: if /etc/resolv.conf
+// exists, the platform can resolve for itself and nothing here should interfere.
+func acmeHTTPClient() *http.Client {
+	if _, err := os.Stat("/etc/resolv.conf"); err == nil {
+		return nil // platform resolver is configured; leave it alone
+	}
+	servers := acmeFallbackResolvers
+	if s := envknob.String("TS_ACME_DNS"); s != "" {
+		servers = strings.Split(s, ",")
+	}
+	r := &net.Resolver{
+		PreferGo: true,
+		Dial: func(ctx context.Context, network, _ string) (net.Conn, error) {
+			var d net.Dialer
+			var firstErr error
+			for _, s := range servers {
+				c, err := d.DialContext(ctx, network, strings.TrimSpace(s))
+				if err == nil {
+					return c, nil
+				}
+				if firstErr == nil {
+					firstErr = err
+				}
+			}
+			return nil, firstErr
+		},
+	}
+	return &http.Client{
+		Transport: &http.Transport{
+			Proxy:             http.ProxyFromEnvironment,
+			DialContext:       (&net.Dialer{Timeout: 30 * time.Second, Resolver: r}).DialContext,
+			ForceAttemptHTTP2: true,
+		},
+	}
+}
