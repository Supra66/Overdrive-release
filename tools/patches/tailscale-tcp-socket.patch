+// tcpAddr reports whether path names a loopback TCP address ("host:port")
+// rather than a filesystem path for a unix socket.
+//
+// Android needs this. tailscaled runs there as the shell uid while its clients
+// live in an app uid, and a unix socket in a shell-writable directory is not
+// reachable across that boundary — an app uid cannot open /data/local/tmp/...
+// So the daemon and CLI address each other over loopback TCP instead.
+//
+// A filesystem path is anything rooted at / or . — checked first, so a path
+// that happens to contain a colon is never mistaken for an address. Everything
+// else must parse as host:port with a numeric port.
+func tcpAddr(path string) (string, bool) {
+	if path == "" || strings.HasPrefix(path, "/") || strings.HasPrefix(path, ".") {
+		return "", false
+	}
+	host, port, err := net.SplitHostPort(path)
+	if err != nil || host == "" || port == "" {
+		return "", false
+	}
+	if _, err := strconv.Atoi(port); err != nil {
+		return "", false
+	}
+	return path, true
+}
+
 func connect(ctx context.Context, path string) (net.Conn, error) {
 	var std net.Dialer
+	if addr, ok := tcpAddr(path); ok {
+		return std.DialContext(ctx, "tcp", addr)
+	}
 	return std.DialContext(ctx, "unix", path)
 }
 
