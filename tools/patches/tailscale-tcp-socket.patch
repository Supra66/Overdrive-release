+
+// IsLoopbackTCP reports whether the connection is a TCP connection whose peer is
+// on the loopback interface.
+//
+// The local API normally lives on a unix socket, and the whole permission model
+// below leans on that: peer credentials identify the caller, and a non-unix
+// connection gets no access at all. On Android there is no usable unix socket —
+// tailscaled runs as the shell uid while its clients run as app uids, and no
+// directory is both shell-writable and app-readable — so the local API is bound
+// to loopback TCP instead (see safesocket).
+//
+// Loopback TCP carries no peer credentials, so it cannot be identified the same
+// way. It is instead trusted on the same basis the unix socket is: reaching it
+// at all requires already being a local process on the device. That is a real
+// widening — any local process that can open 127.0.0.1:<port> gets full control
+// of tailscaled, where the unix socket would have restricted it by uid. It is
+// inherent to putting the local API on TCP, not something added here.
+func (ci *ConnIdentity) IsLoopbackTCP() bool {
+	if ci.conn == nil {
+		return false
+	}
+	a, ok := ci.conn.RemoteAddr().(*net.TCPAddr)
+	return ok && a.IP.IsLoopback()
+}
 func (ci *ConnIdentity) Creds() PeerCreds { return ci.creds }
 
